# gcp-infra-foundation ルート変数のサンプル
# 実ファイルは terraform.tfvars にコピーして値を埋める（*.tfvars は gitignore 対象）。

project_id         = "gen-fw-line-meo"
region             = "asia-northeast1"
billing_account_id = "000000-000000-000000" # 実際の請求先アカウント ID に置換
budget_amount_jpy  = 10000
alert_email        = "ops@example.com"
github_repository  = "ManatoYamashita/fw-line-meo"

# Places API クォータ上限（Req 7.2）。quota_id は Cloud Quotas の実名。
# バッチが使う日次エンドポイント（検索＋詳細取得）をまとめて上限設定。
# 実名確認: cloudquotas API の quotaInfos（runbook 参照）。空 {} なら上限なし。
places_quota_caps = {
  SearchTextRequestPerDayPerProject   = 1000
  SearchNearbyRequestPerDayPerProject = 1000
  GetPlaceRequestPerDayPerProject     = 1000
}

# review-acquisition（機能3）の env。gemini_model は既定で足りるため通常は省略可。
# survey_base_url は survey-web 初回デプロイ後の Cloud Run URL（またはカスタムドメイン）を設定。
# gemini_model    = "gemini-3.1-flash-lite"
# survey_base_url = "https://survey-web-xxxxxxxxxx-an.a.run.app"

# agency-dashboard（代理店ダッシュボード）の env。
# dashboard_web_origin は dashboard-web 初回デプロイ後の Cloud Run URL（CORS 許可元）を設定。
# dashboard_web_origin = "https://dashboard-web-xxxxxxxxxx-an.a.run.app"

# competitive-daily-summary（機能1）の env。delivery-job（毎時配信）・store-detail（LIFF詳細閲覧）が要求する。
# line_channel_id は LINE Developers コンソールの Messaging API チャネル ID。
# liff_url / liff_channel_id / liff_id は store-detail の LIFF チャネル発行後
# （task 6.2・#6 LINE 基盤と共同の runbook 手順・Messaging API チャネルと同一プロバイダー必須）に設定する。
# liff_channel_id は発行された LINE Login チャネルの ID、liff_id はその配下の LIFF アプリ ID
# （liff_url の {liffId} 部分と同一値）。
# line_channel_id = "1234567890"
# liff_url        = "https://liff.line.me/1234567890-abcdefgh"
# liff_channel_id = "1234567891"
# liff_id         = "1234567890-abcdefgh"

# gbp-post-review-reply（機能2・機能1-b）の env。line-webhook が要求する（非秘匿の 2 値のみ）。
# gbp_oauth_client_id は GCP コンソールで作成した OAuth クライアント（Web アプリケーション）の ID。
# gbp_oauth_redirect_url は line-webhook の公開 URL + /gbp/oauth/callback
# （OAuth クライアントの承認済みリダイレクト URI と同一値）。
# クライアントシークレットと暗号化鍵は tfvars ではなく Secret Manager へ out-of-band 投入:
#   gcloud secrets versions add gbp-oauth-client-secret --data-file=-
#   openssl rand -base64 32 | gcloud secrets versions add gbp-token-cipher-key --data-file=-
# gbp_oauth_client_id    = "000000000000-xxxxxxxx.apps.googleusercontent.com"
# gbp_oauth_redirect_url = "https://line-webhook-xxxxxxxxxx-an.a.run.app/gbp/oauth/callback"
